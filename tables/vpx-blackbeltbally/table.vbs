Sub Trig32				' This is for sw32 in the launch lane, Mainly used to start shoot again timer
			'L79.State = LightStateBlinking
			'SetLightColor L79, red, 2   ' Change Kicker 1 light to flashing purple
			'SetLightColor L79, white, 2   ' Change Kicker 1 light to flashing purple
	Debug " W32 HAS BEEN TRIGGERED: 1X0 :R/T/A/M "&bBallSaverReady &" "&BallSaverTime &" "&bBallSaverActive & " "&MultiballMode
	GameStarted = 1
	if ShootAgainEnable = 1 Then
		bBallSaverReady = 1
	End If

    If(bBallSaverReady = 1) AND(BallSaverTime <> 0) And(bBallSaverActive = 0) And(MultiballMode = 0) Then
		Debug "EnableBS 1X00 Values :R/T/A/M " &bBallSaverReady &BallSaverTime &bBallSaverActive &MultiballMode
        EnableBallSaver BallSaverTime
    End If

	ResetLightCounts
	PuPEvent(601)  ' Reset Topper screen to main background topper
End Sub
'================================================
Sub EnableBallSaver(seconds)				' This routine sets up the ball save configuration
    debug "BallSAVER started"
    bBallSaverActive = 1
    bBallSaverReady = 0  ' disable ballsaver until ready for use again
    ' start the timer
    BallSaverTimerExpired.Interval = 1000 * seconds
    BallSaverTimerExpired.Enabled = 1
    BallSaverSpeedUpTimer.Interval = 1000 * seconds -(1000 * seconds) / 3
    BallSaverSpeedUpTimer.Enabled = 1
    ' if you have a ball saver light you might want to turn it on at this point (or make it flash)
	SAEnable
End Sub

Sub BallSaverTimerExpired_Timer()  			'' Timer used to track how long shootagain lasts
    'debug.print "Ballsaver ended"
    BallSaverTimerExpired.Enabled = 0
    ' clear the flag
    bBallSaverActive = 0
    ' if you have a ball saver light then turn it off at this point
	SADisable
End Sub

Sub BallSaverSpeedUpTimer_Timer()     ' Timer is used to change the shootagain bulb to start flashing when nearing end of time
    'debug.print "Ballsaver Speed Up Light"
    BallSaverSpeedUpTimer.Enabled = 0
    ' Speed up the blinking
	if ShootAgainEnable = 1 Then
		L27.BlinkInterval = 80
		L27.State = 2
	End If
End Sub

