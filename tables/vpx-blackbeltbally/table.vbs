Sub SetDifficulty
	Select Case Difficulty
	  Case 0:TrustPost  = 1:WorkingGates = 0 ' EASY MODE
	  Case 1:TrustPost = 1:WorkingGates = 1 ' MEDIUM MODE
      Case 2:TrustPost = 0:WorkingGates = 1  ' HARD MODE
	End Select

    If TrustPost = 0 Then
		Primitive018.visible = False
		RubberPin.visible = False
		RubberPin.collidable = False
   Else
		Primitive018.visible = True
		RubberPin.visible = True
		RubberPin.collidable = True
	End If

    if WorkingGates = 0 Then
		RightGate.RotateToEnd
		LeftGate.RotateToEnd
    End If

	' Set Gate Reset Time for Medium and Hard modes
	if Difficulty = 1 Then
		GateResetTime = 30000		' 30 seconds
	Elseif Difficulty = 2 Then
		GateResetTime = 3000	'  3 seconds
	End If
End Sub

