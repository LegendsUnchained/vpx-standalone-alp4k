'Drain & Kickers
Sub Drain_Hit
	if bBallInPlungerLane <> 1 Then ' Check if ball is already in lane
		if SaveBall = 1 Then    ' Only needed when not in multiball mod
			PuPEvent(615)
			Drain.DestroyBall
			TriggerScript 500, "AddmBall7"
			Debug "CurrBall7 :" &CurrBallNumber
			SaveBall = 0
			SolRightGate 1
			SolLeftGate 1
			' rotate outlanes
		Else
			Debug "Drain Hit"
			if MultiballMode = 0 Then
				bBallSaverReady = 1
				bBallSaverActive = 0
			End If
			ResetKarateDrops  ' Reset counter checking bonus mulitplier
			IncreaseBallCount 
			PlaySoundAt "fx_drain", Drain
			bsTrough.AddBall Me
		End If
	Else	
		Debug "WTH Happened BIP/CurrBall " &BIP &" " &CurrBallNumber
	End If
End Sub

