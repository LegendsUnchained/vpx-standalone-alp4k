Sub EnableCheat ' NOT USING --- Could add an invisible barrier to deter balls from draining during multiball -- was an alternative to shoot again timer 
	MultiBallCheat.collidable = True
	PuPEvent(616) ' pup advising of cheat mode enabled -- make sure duration matches timer enabled default 15 seconds
	EnableBallSaver mBallSaverTime
End Sub

Sub DisableCheat
	MultiBallCheat.collidable = False
End Sub
'-----------------------------------------------------------------------------------------
Sub CheckBallLocked  '' called from Kicker1 BonusCollection --- Determines what function Kicker 1 should serve besides collecting bonuses (ball locks)
	Debug "CheckBallLocked Enter " &SupressKTLights
	if isLocked = 0 And BallLockReady = 1 Then
		Debug "Ball 1 isLocked: " &isLocked &" " &BallLockReady 
		isLocked = 1
		ResetSideHits  ' reset the side hit count for ball lock 2
		ResetAllLightsColor 
		PuPEvent(611)     ' Ball 1 is locked pup video
		SupressKTLights = 1
		TriggerScript 300, "ResetKarateTargetsCounts"
		SetLightColor L11, green, 2
		SetLightColor L41, green, 2
		Debug "Lock 1 AFTER isLocked: " &isLocked &" " &SupressKTLights
		if MultiballMode <> 1 Then
			bsLeft.AddBall 0
		Else
			Triggerscript 300, "Kicker1.kick 140,16"
		End If
		'bsLeft.AddBall 0
	Elseif isLocked = 1 And BallLockReady = 2 Then
		Debug "Ball 2 isLocked: " &isLocked &" " &SupressKTLights
		Debug "MULTIBALL READY"
		isLocked = 2
		ResetKarateTargetsCounts
		ResetSideHits
		ResetAllLightsColor 
		SetLightColor L23, blue, 2  ' Change body hit light and flash
		PuPEvent(612)     ' Ball 2 is locked pup video
		PuPEvent(613) 
		if MultiballMode <> 1 Then
			bsLeft.AddBall 0
		Else
			Triggerscript 300, "Kicker1.kick 140,16"
		End If
		'bsLeft.AddBall 0
	Elseif isLocked = 1 And BallLockReady = 1 Then
		Debug "Check if Ball Lock 2 is ready " &SupressKTLights
		if MultiballMode <> 1 Then
			bsLeft.AddBall 0
		Else
			Triggerscript 300, "Kicker1.kick 140,16"
		End If
		'bsLeft.AddBall 0
	Else
		Debug "ELSE : isLocked: " &isLocked &" "&BallLockReady &" " &SupressKTLights
		if MultiballMode <> 1 Then
			bsLeft.AddBall 0
		Else
			Triggerscript 300, "Kicker1.kick 140,16"
		End If
		'bsLeft.AddBall 0
	End If
End Sub
