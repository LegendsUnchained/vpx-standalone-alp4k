            For ii = 0 To UBound(chgLED)
                num = chgLED(ii, 0):chg = chgLED(ii, 1):stat = chgLED(ii, 2)
                if(num <32)then
                    For Each obj In Digits(num)
                        If chg And 1 Then obj.State = stat And 1
                        chg = chg \ 2:stat = stat \ 2
                    Next
                End If
            Next
        End If
    End If
End Sub

