Sub DrainGate_Hit()					' Used to determine if a ball should be drained or saved
		Debug "ENTER DrainGate Multi/SA/BIP/MBalls : " &MultiballMode &" " &ShootAgainEnable &" " &BIP &" " &MaxBalls
	if MultiballMode = 3 Then
	' This should only happen if EndMultiballMode subroutine fails
		Debug " In Drain Hit MM3 "&BIP &" " &CurrBallNumber
		MultiballMode = 0
		isLocked = 0
		BallLockReady = 0
		SupressKTLights = 0
		k3gate.collidable = 0
		ResetSideHits
	End If

	Debug "DRAIN GATE   " &MultiballMode &" BIP: " &BIP
	if MultiballMode = 1 And ShootAgainEnable = 0 Then 
		Debug "MM 1 :  " &MultiballMode
		if BIP < 3 Then
			MultiballMode = 2    ' ball lost so advance mode so that next lost ball stops multiball mode
		End If
	End If

	if MultiballMode = 2  And ShootAgainEnable = 0 And BIP < 3 Then   ' Lost second ball while in multiball mode, end multiball mode '
	'if MultiballMode <> 0  And ShootAgainEnable = 0 And BIP < 3 Then   ' Lost second ball while in multiball mode, end multiball mode 
		MultiballMode = 3
		Debug "MM 2  :: Ending Multiball mode in 250ms " &MultiballMode
		Triggerscript 250, "EndMultiballMode"
	End If

	if ShootAgainEnable = 1 And MultiballMode = 0 Then ' In shoot again mode, move ball to launch lane and disable shoot again.
		Debug "MM 0  ::  Not In shootagain mode" &MultiballMode
		SaveBall = 1
		SADisable
	End If
	
	if MultiballMode = 1 And ShootAgainEnable = 1 And BIP =< MaxBalls Then
		TriggerScript 1000, "AddmBall3"
	Else	' not in multiball mode and not in shootagain mode	
		Debug " Hit ELSE of DrainGate Clause Multi/SA : " &MultiballMode &" " &ShootAgainEnable &" " &BIP &" " &MaxBalls
	End If


End Sub
