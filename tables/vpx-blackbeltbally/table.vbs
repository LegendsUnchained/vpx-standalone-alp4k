Sub EvaluateLights
'Debug "EVALUATE Multiplier: " &DoubleCount &" " &TripleCount &" " &QuadCount &" " &QuintCount
'Debug "EVALUATE Belts: " &YellowCount &" " &GreenCount &" " &BlueCount &" " &BlackCount

	if EBArrowCount >= LimitCount Then 
		'EBLIT = 1   ' do not turn on handled elsewhere in script
	End If

	if EBOutLaneCount >= LimitCount Then 
		EBLIT = 2
	End If

	if QuintCount >= LimitCount Then 
		Debug "  5X Multiplier Awarded "&QuintCount
		CheckBelt(5)
	elseif QuadCount >= LimitCount Then 
		Debug "  4X Multiplier Awarded"
		CheckBelt(4)
	elseif TripleCount >= LimitCount Then 
		Debug "  3X Multiplier Awarded"
		CheckBelt(3)
	elseif DoubleCount >= LimitCount Then 
		Debug "  2X Multiplier Awarded"
		CheckBelt(2)
	Else
		CheckBelt(1)
	End If


End Sub
