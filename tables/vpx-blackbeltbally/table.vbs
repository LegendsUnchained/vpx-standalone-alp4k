Sub AddmBall3				' Kicker used for Initial Multiball  -- loads between the bumpers at top of the screen
	if BIP < MaxBalls Then
		PlaySoundAt "fx_kicker_enter", kicker3
		Kicker3.CreateBall
		Kicker3.kick 5,27
		BIP = BIP + 1
		Debug "Ball Created :3:"&BIP &" " &CurrBallNumber
	End If
End Sub

Sub AddmBall7		'Kicker used for normal saved balls -- Loads to trough
	Debug "Ball Created :7:"&BIP &" " &CurrBallNumber
	PlaySoundAt "fx_kicker_enter", kicker3
	Kicker7.CreateBall
	Kicker7.kick 7,1,1 ' dont need to increment ball count
End Sub
