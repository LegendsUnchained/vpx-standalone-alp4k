Sub CountLights
' Multiplier Light Counts
	if L62.State = LightStateOn Then QuintCount = QuintCount +1
	if L93.State = LightStateOn Then QuadCount = QuadCount + 1
	if L77.State = LightStateOn Then TripleCount = TripleCount + 1
	if L61.State = LightStateOn Then DoubleCount = DoubleCount + 1

' Check ExtraKeyHelpBall Lights
	if L49.State = LightStateOn Then EBOutLaneCount = EBOutLaneCount + 1
	if L85.State = LightStateOn Then EBArrowCount = EBArrowCount + 1
	if L15.State = LightStateOn Then BHCount = BHCount + 1  

' Belt Light Counts
	if L92.State = LightStateOn Then BlackCount = BlackCount + 1
	if L76.State = LightStateOn Then BlueCount = BlueCount + 1
	if L60.State = LightStateOn Then GreenCount = GreenCount + 1
	if L91.State = LightStateOn Then YellowCount = YellowCount + 1

End Sub
