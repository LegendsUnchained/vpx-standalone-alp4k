Sub IncreaseBallCount
	CurrBallNumber = CurrBallNumber + 1
	CheckGameOver
	EvaluateLights ' lost ball so evaulate table conditions
End Sub

Sub CheckGameOver
	'Debug "Number of Balls : "&CurrBallNumber
	If CurrBallNumber > 3 And bBallInPlungerLane = 0 Then
		PuPEvent(600)  ' Trigger Game Over Event
		' Reset some things before starting new game
		GameOver = 1
		GameRestart
	else
		PuPEvent(500) ' Trigger Lost Ball EventSetLamp
	End If
End Sub

