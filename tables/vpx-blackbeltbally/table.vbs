Sub EndMultiballMode  '' Down to a single ball , so time to end multiball mode and reset variables
		k3gate.collidable = 0
		Debug "End Multiball " &MultiballMode
		MultiballMode = 0
		isLocked = 0   ' Reset multiball mode
		BallLockReady = 0
		SupressKTLights = 0
		ResetSideHits
End Sub
