Sub CheckNumDrops
Dim j,cBallCnt

cBallCnt = 0

For j = 0 to 5
	if  KarateDrops(j) = 1 Then	
		cBallCnt = cBallCnt + 1
	End If
Next

	Select Case cBallCnt
        Case 0:
        Case 1:PuPEvent(502)
        Case 2:PuPEvent(503)
        Case 3:PuPEvent(504)
        Case 4:PuPEvent(505)
        Case 5:PuPEvent(506)
		Case 6:PuPEvent(507):PuPEvent(508): ResetKarateDrops
    End Select
	
	if SupressKTLights = 0 Then
		CheckKarateTargets
	Else
		'ResetKarateTargetsCounts   ' should not 
	End If
End Sub
'--------------------------------------------------------------------------------------------
Sub CheckKarateTargets
Dim i
KarateCnt = 0
For i = 0 to 5
	if KarateTargetHits(i) = 1 Then	
		KarateCnt = KarateCnt + 1
	End If
Next

	if KarateCnt = 6 And SupressKTLights = 0 Then
		'if FirstPass = 1 Then
		L79.State = LightStateBlinking		' required to get lock lit to light right away, not sure why
		SetLightColor L79, white, 0   ' Change Kicker 1 light to flashing purple
		PuPEvent(609)   ' Ball Lock Ready Video
		BallLockReady = 1
	End If

End Sub
