Sub pupDMDUpdate_Timer()
	if isLocked = 0 Or isLocked = 3 Then
		SupressKtLights = 0 'Reset Supression, this hangs open sometimes on game restarts
	End If

	if isLocked = 1 Then			' Fix Side hit lights, sometimes they get out of sync when a ball is lost
		if SideHits(0) = 0 Then
			SetLightColor L41, green, 2
			p041.material = "InsertGreenOnTri"
			p041Off.material = "InsertGreenOffTri"
		Elseif SideHits(0) = 1 Then
			SetLightColor L41, green, 1
			p041.material = "InsertGreenOnTri"
			p041Off.material = "InsertGreenOffTri"
		End If
		if SideHits(1) = 0 Then
			SetLightColor L11, green, 2
			p011.material = "InsertGreenOnTri"
			p011Off.material = "InsertGreenOffTri"
		Elseif SideHits(1) = 1 Then
			SetLightColor L11, green, 1
			p011.material = "InsertGreenOnTri"
			p011Off.material = "InsertGreenOffTri"
		End If

		If SideHits(0) = 1 And SideHits(1) = 1 Then
			SetLightColor L79, green, 2
			p079.material = "InsertGreenOnTri"
			p079Off.material = "InsertGreenOffTri"
		End IF

	End If

	if isLocked = 2 And BallLockReady = 2 Then
		'SetLightColor L41, white, SideHitsState(0)
		'SetLightColor L11, white, SideHitsState(1)
		SetLightColor L79, green, 2
		p079.material = "InsertGreenOnTri"
		p079Off.material = "InsertGreenOffTri"
	End If

	if GameStarted = 0 Then   ' make sure table is reset
		Debug "PUP DMD TIMER - RESET"
		FirstPass = 1
		BeltRank = 1
		GameStarted = 0
		EBLIT = 0
		CurrBallNumber = 1
		BIP = 1
		MultiballMode = 0
		isLocked = 0
		ResetKarateDrops
		ResetKarateTargetsCounts
		ResetSideHits
		ResetLightCounts
		bBallSaverActive = 0
		bBallSaverReady = 0
		BallLockReady = 0
		ResetAllLightsColor
		CreateMultiballTimer.Enabled = False
	End If
End Sub
