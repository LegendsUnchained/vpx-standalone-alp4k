Sub GameUpdate_Timer()    					' This Timer is mainly used to check BeltRank and Bonus Miltiplier, also tracks if extraball was awarded
	'Debug "GAME UPDATE"
	if MultiballMode = 3 Then
	' This should only happen if EndMultiballMode subroutine fails
		MultiballMode = 0
		isLocked = 0
		BallLockReady = 0
		SupressKTLights = 0
		k3gate.collidable = 0
		ResetSideHits
	End If

	if SupressKTLights = 0 Then
		CheckKarateTargets ' sweep targets
	Else
		'Debug " SupressKtLightts 1 " &SupressKTLights
		'ResetKarateTargetsCounts
	End If

	if MultiballMode <> 1 Then	' make sure gate is open during normal play
		'SupressKTLights = 0
		k3gate.collidable = 0
	End If

	CheckReady ' Check if table is setup for extra ball
	BaseCount = BaseCount + 1
	CountLights
'	if BaseCount > MaxCount And GameStarted = 1 Then
	if BaseCount > MaxCount Then
		Debug "SupressKtLights " &SupressKTLights
		EvaluateLights
		TriggerScript 300, "ResetLightCounts"
	End If

End Sub
