Sub CheckSideHits			'' PHASE 2 of multiball, if both side hits made, prep lock2
	Debug "SideHits :"&SideHits(0) &SideHits(1)
	if SideHits(0) = 1 And SideHits(1) = 1 And isLocked = 1 Then	
		BallLockReady = 2 ' Second phase met Lock2 is Ready
		PuPEvent(610) ' Lock2 Ready Video
	End If
End Sub
'-----------------------------------------------------------------------------------------
Sub CheckExtraBall		' track multiball so gameover trigger can be accurate -- not sure this is needed anymore but left in to be safe

	if MultiballMode = 1 Then
		TriggerScript 400, "Kicker2.kick 185,13"
	Debug "KICKER2 KICKED BALL kick2 185 13"
	Else
		bsMiddle.addBall 0
	Debug "KICKER2 KICKED BALL addball 0"
	End If



	if EBLIT = 1 Then
		Debug "EXTRABALL GRANTED"
		CurrBallNumber = CurrBallNumber - 1  ' An Extra ball was earned so we need to reduce the ball count
		EBLIT = 0 ' Reset Extra Ball Ready
	End If

	if ShootAgainEnable = 0 And isLocked = 2 Then
		Debug " MULTIBALL MODE STARTING " &BIP &" " &MaxBalls		
		ReleaseLockedBalls
	End If

End Sub
'-----------------------------------------------------------------------------------------
Sub ReleaseLockedBalls					' MULTIBALL MODE STARTER ROUTINE
	Debug "RELEASE LockedBall Enter : " &isLocked &" " &MultiballMode &" " &BIP &" " &MaxBalls
	if MultiballMode = 0 Then
		MultiballMode = 1   '  Turn on Multiball Mode
		SupressKTLights = 0
		ResetMultiBallColors
		isLocked = 3
		PuPEvent(614)
		'CreateMultiballTimer.Enabled = True
		'EnableCheat			'' Not being used but if game acts buggy you can try to remove the comment on this line to resolve
		EnableBallSaver 15
		PrepareMM
		if BIP < MaxBalls Then
			TriggerScript 1500, "AddmBall3 '" ' Add second ball
			Debug " Create ball 2, from right kicker ,enable tmpDrain "&BIP
		End If
		if BIP < MaxBalls Then
			TriggerScript 4000,  "AddmBall3"
			Debug " Create ball 3, from right kicker ,enable tmpDrain "&BIP
		End If
	Else
		Debug " We did not do anything this pass "&isLocked &" " &MultiballMode &" " &BIP
	End If
	
End Sub

Sub PrepareMM
	k3gate.collidable = 1
	ResetKarateTargetsCounts
End Sub

Sub CreateMultiballTimer_Timer()
	DisableCheat   ' Turn off the Multiball Cheat
	CreateMultiballTimer.Enabled = False
End Sub
