Sub CheckReady
'Debug "CHECK Ready"
	if EBArrowCount >= LimitCount And BHCount <= 2 Then
		Debug "EXTRABALL READY: "&EBArrowCount &" " &BHCount
		EBLIT = 1 ' Every leg light is lit except the Body , if body is hit extra ball should be awarded
	End If
End Sub
